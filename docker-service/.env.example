# ============================================
# Facebook Automation Docker Service
# ============================================

# Server
PORT=3000
HOST=0.0.0.0

# Authentication (comma-separated API keys)
API_KEYS=your-api-key-here
JWT_SECRET=your-jwt-secret-at-least-32-characters-long

# Redis
REDIS_URL=redis://redis:6379

# Encryption (32+ characters for AES-256)
ENCRYPTION_KEY=your-encryption-key-at-least-32-chars

# Browser
BROWSER_HEADLESS=true
MAX_CONCURRENCY=2
DEFAULT_TIMEOUT=60000

# Error Handling
SCREENSHOT_ON_ERROR=true
HTML_DUMP_ON_ERROR=true

# Logging
LOG_LEVEL=info

# Webhook (optional)
# WEBHOOK_URL=https://your-n8n-instance.com/webhook/facebook-automation

# Data Directory
DATA_DIR=/data
