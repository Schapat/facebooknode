# ============================================
# Facebook Automation - Environment Variables
# ============================================

# API Authentication (comma-separated keys)
API_KEYS=your-secure-api-key-here

# JWT Secret (min 32 chars)
JWT_SECRET=your-jwt-secret-at-least-32-characters-long!!

# AES Encryption Key (min 32 chars)
ENCRYPTION_KEY=your-encryption-key-at-least-32-chars!!

# Browser Settings
MAX_CONCURRENCY=2
DEFAULT_TIMEOUT=60000

# Logging
LOG_LEVEL=info

# Optional: Webhook URL for n8n
# WEBHOOK_URL=https://your-n8n-instance.com/webhook/facebook-automation
